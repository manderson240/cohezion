{
  "name": "kyutai-obsidian-plugin",
  "version": "0.1.0",
  "description": "Kyutai voice AI integration for Obsidian - TTS, STT, voice cloning",
  "main": "esbuild.config.mjs",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js --sourcemap --watch",
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js",
    "test": "jest",
    "lint": "eslint src --ext ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "kyutai",
    "tts",
    "stt",
    "voice",
    "ai"
  ],
  "author": "Kyutai Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "16.11.6",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "esbuild": "0.13.12",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
