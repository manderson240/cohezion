# Trigger.dev Configuration
# Copy this to .env and fill in your values

# Your Trigger.dev secret API key (from project dashboard)
# Format: tr_dev_* (development) or tr_prod_* (production)
TRIGGER_SECRET_KEY=

# Trigger.dev API URL (cloud or self-hosted)
# Cloud: https://api.trigger.dev
# Self-hosted: https://your-trigger-instance.example.com
TRIGGER_API_URL=https://api.trigger.dev

# Trigger.dev project reference (from project settings)
TRIGGER_PROJECT_REF=cohezion
