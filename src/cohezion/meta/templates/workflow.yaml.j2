name: "{{ workflow.name }}"
description: "{{ workflow.description }}"
version: "{{ workflow.version | default('1.0') }}"
created_by: "cohezion-meta-generator"

{% if workflow.trigger %}
triggers:
{% for trigger in workflow.trigger %}
  - type: {{ trigger.type }}
    condition: {{ trigger.condition | tojson }}
{% endfor %}
{% endif %}

agents:
{% for agent in workflow.agents %}
  - name: {{ agent.name }}
    type: {{ agent.type }}
    config:
      model: {{ agent.model | default('deepseek-r1:7b') | tojson }}
      priority: {{ agent.priority | default(5) }}
{% endfor %}

steps:
{% for step in workflow.steps %}
  - name: {{ step.name }}
    agent: {{ step.agent }}
    input: {{ step.input | tojson }}
    output: {{ step.output | default('result') }}
    on_error: {{ step.on_error | default('retry') | tojson }}
{% endfor %}

data_flow:
{% for flow in workflow.data_flow %}
  - from: {{ flow.from }}
    to: {{ flow.to }}
    field: {{ flow.field }}
{% endfor %}

parallel:
{% for group in workflow.parallel | default([]) %}
  - steps: {{ group.steps | tojson }}
    max_concurrent: {{ group.max_concurrent | default(3) }}
{% endfor %}

quality_gates:
{% for gate in workflow.quality_gates | default([]) %}
  - step: {{ gate.step }}
    metric: {{ gate.metric }}
    threshold: {{ gate.threshold }}
    action: {{ gate.action | default('stop') | tojson }}
{% endfor %}
