# DEPRECATED: GitLab CI Configuration

This file has been deprecated as of 2026-02-13 (Session 57).

**Rationale**: Migration to GitHub Actions as primary CI/CD system.
- GitHub Actions provides better integration with GitHub-hosted repositories
- Simplified CI/CD management (single vendor)
- Enables Claude Code on the web features

**Removal Schedule**: 2026-08-13 (6 months, provides rollback window)

**Historical Reference**: Preserved for reference purposes.

---

Original GitLab CI Configuration:

stages:
  - lint
  - validate
  - test
  - compound
  - typecheck

variables:
  UV_CACHE_DIR: "$CI_PROJECT_DIR/.cache/uv"
  COHEZION_CI: "true"

default:
  tags:
    - cohezion

# Cache uv dependencies between pipeline runs
cache:
  key: "${CI_COMMIT_REF_SLUG}"
  paths:
    - .cache/uv/
    - .venv/

# Install dependencies once per job
.uv-setup: &uv-setup
  before_script:
    - uv sync --frozen --quiet

# ── Lint ──────────────────────────────────────────────────────

lint:format:
  stage: lint
  <<: *uv-setup
  script:
    - uv run ruff format --check src/ tests/
  allow_failure: true  # 35 files need reformatting — tracked for cleanup

lint:check:
  stage: lint
  <<: *uv-setup
  script:
    - uv run ruff check src/ tests/
  allow_failure: true  # 114 pre-existing errors — tracked for cleanup

# ── Validate ──────────────────────────────────────────────────

validate:agent-files:
  stage: validate
  <<: *uv-setup
  script:
    - uv run python scripts/ci/validate_agents.py

validate:prime-skills:
  stage: validate
  <<: *uv-setup
  script:
    - uv run python scripts/ci/validate_skills.py

validate:registry:
  stage: validate
  <<: *uv-setup
  script:
    - uv run python scripts/ci/validate_registry.py

validate:imports:
  stage: validate
  <<: *uv-setup
  script:
    - uv run python -c "from cohezion.core.template_engine import TemplateEngine; from cohezion.registry.skill_registry import load_registry; from cohezion.registry.capability_registry import CapabilityRegistry; from cohezion.core.compound.retrospection import RetrospectionEngine; from cohezion.validation.agent_schema import validate_all_agent_files; print('All critical imports OK')"

# ── Test ──────────────────────────────────────────────────────

test:unit:
  stage: test
  <<: *uv-setup
  script:
    - uv run pytest tests/unit/ -v --tb=short --junitxml=report.xml --cov=src/cohezion --cov-report=xml:coverage.xml --cov-report=term
  artifacts:
    reports:
      junit: report.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml
    when: always

test:integration:
  stage: test
  <<: *uv-setup
  script:
    - uv run pytest tests/ --ignore=tests/unit/ -v --tb=short --junitxml=integration-report.xml
  artifacts:
    reports:
      junit: integration-report.xml
    when: always
  allow_failure: true

# ── Compound ──────────────────────────────────────────────────

compound:audit:
  stage: compound
  <<: *uv-setup
  script:
    - uv run python scripts/ci/compound_audit.py
  artifacts:
    paths:
      - compound-report.json
    when: always
  allow_failure: true

# ── Typecheck ─────────────────────────────────────────────────

typecheck:mypy:
  stage: typecheck
  <<: *uv-setup
  script:
    - uv run mypy src/cohezion/ --ignore-missing-imports
  allow_failure: true
