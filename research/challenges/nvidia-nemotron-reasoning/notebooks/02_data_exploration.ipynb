    "# Data Exploration for NVIDIA Nemotron Model Reasoning Challenge\n",
    "\n",
    "This notebook explores the competition dataset to understand its structure, contents, and characteristics.\n",
    "This is essential for designing an effective solution approach.\n",
    "\n",
    "## Overview\n",
    "\n",
    "We'll examine:\n",
    "1. Basic dataset properties (size, columns, data types)\n",
    "2. Sample data to understand the problem format\n",
    "3. Target variable distribution (if applicable)\n",
    "4. Text characteristics (length, language, complexity)\n",
    "5. Any unique patterns or characteristics\n",
    "\n",
    "This exploration will inform our feature engineering, model selection, and preprocessing strategies."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import necessary libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import json\n",
    "\n",
    "# Set plotting style\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"📊 Data Exploration for NVIDIA Nemotron Model Reasoning Challenge\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the data\n",
    "DATA_DIR = Path(\"data\")\n",
    "TRAIN_PATH = DATA_DIR / \"train.csv\"\n",
    "TEST_PATH = DATA_DIR / \"test.csv\"\n",
    "\n",
    "print(f\"Loading training data from: {TRAIN_PATH}\")\n",
    "print(f\"Loading test data from: {TEST_PATH}\")\n",
    print()\n",
    "\n",
    "# Load datasets\n",
    "df_train = pd.read_csv(TRAIN_PATH)\n",
    "df_test = pd.read_csv(TEST_PATH)\n",
    "\n",
    "print(\"✓ Data loaded successfully!\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic Dataset Properties\n",
    "print(\"=== DATASET PROPERTIES ===\")\n",
    print(f\"Training data shape: {df_train.shape}\")\n",
    f\"Test data shape: {df_test.shape}\")\n",
    print()\n",
    "\n",
    "print(\"\\nColumns:\")\n",
    for col in df_train.columns:\n",
    "    print(f\"  - {col}: {df_train[col].dtype}\")\n",
    print()\n",
    "\n",
    "print(\"\\nMemory usage:\")\n",
    f\"Train: {df_train.memory_usage(deep=True).sum() / 1024**2:.1f} MB\")\n",
    f\"Test: {df_test.memory_usage(deep=True).sum() / 1024**2:.1f} MB\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Column Names and First Few Rows\n",
    "print(\"=== COLUMN NAMES AND SAMPLE DATA ===\")\n",
    print(f\"Columns: {list(df_train.columns)}\")\n",
    print()\n",
    "\n",
    "print(\"First 5 rows of training data:\")\n",
    display(df_train.head())\n",
    print()\n",
    "\n",
    "print(\"First 5 rows of test data:\")\n",
    display(df_test.head())\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data Types and Missing Values\n",
    "print(\"=== DATA TYPES AND MISSING VALUES ===\")\n",
    "\n",
    "col_info = pd.DataFrame({\n",
    "    'column': df_train.columns,\n",
    "    'dtype': [str(dtype) for dtype in df_train.dtypes],\n",
    "    'non_null_count': df_train.notnull().sum().values,\n",
    "    'null_count': df_train.isnull().sum().values,\n",
    "    'null_percentage': (df_train.isnull().sum() / len(df_train) * 100).values\n",
    "})\n",
    "\n",
    display(col_info)\n",
    print()\n",
    "\n",
    "# Check if train and test have same columns\n",
    "train_cols = set(df_train.columns)\n",
    "test_cols = set(df_test.columns)\n",
    "\n",
    "if train_cols == test_cols:\n",
    "    print(\"✓ Train and test datasets have the same columns\")\n",
    "else:\n",
    "    print(f\"✗ Column mismatch:\")\n",
    "    print(f\"  Only in train: {train_cols - test_cols}\")\n",
    "    print(f\"  Only in test: {test_cols - train_cols}\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "outputs": [],
   "source": [
    "# Target Variable Analysis (if applicable)\n",
    "print(\"=== TARGET VARIABLE ANALYSIS ===\")\n",
    "\n",
    "# Assume last column might be target, or look for common target names\n",
    "possible_target_cols = []\n",
    "for col in df_train.columns:\n",
    "    col_lower = col.lower()\n",
    "    if any(target_word in col_lower for target_word in ['target', 'label', 'answer', 'score', 'rating', 'class']):\n",
    "        possible_target_cols.append(col)\n",
    "\n",
    "if possible_target_cols:\n",
    "    print(f\"Possible target columns: {possible_target_cols}\")\n",
    "    for target_col in possible_target_cols:\n",
    "        print(f\"\\n--- {target_col} ---\")\n",
    "        print(f\"Type: {df_train[target_col].dtype}\")\n",
    "        if df_train[target_col].dtype in ['object', 'string']:\n",
    "            print(f\"Unique values: {df_train[target_col].nunique()}\")\n",
    "            if df_train[target_col].nunique() < 20:\n",
    "                print(f\"Value counts:\\n{df_train[target_col].value_counts().head()}\")\n",
    "        else:\n",
    "            print(f\"Range: [{df_train[target_col].min():.2f}, {df_train[target_col].max():.2f}]\")\n",
    "            print(f\"Mean: {df_train[target_col].mean():.2f}\")\n",
    "            print(f\"Std: {df_train[target_col].std():.2f}\")\n",
    "            # Show histogram for numeric targets\n",
    "            plt.figure(figsize=(8, 4))\n",
    "            plt.hist(df_train[target_col], bins=30, alpha=0.7, edgecolor='black')\n",
    "            plt.title(f'Distribution of {target_col}')\n",
    "            plt.xlabel(target_col)\n",
    "            plt.ylabel('Frequency')\n",
    "            plt.grid(True, alpha=0.3)\n",
    "            plt.show()\n",
    "else:\n",
    "    print(\"No obvious target column identified by name.\")\n",
    "    print(\"All columns will be treated as features unless otherwise specified.\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Text Data Exploration (if text columns exist)\n",
    "print(\"=== TEXT DATA EXPLORATION ===\")\n",
    "\n",
    "# Identify text columns\n",
    "text_columns = []\n",
    "for col in df_train.columns:\n",
    "    if df_train[col].dtype == 'object':\n",
    "        # Check if it looks like text (average length > 20, etc.)\n",
    "        sample_vals = df_train[col].dropna().head(100)\n",
    "        if len(sample_vals) > 0:\n",
    "            avg_length = sample_vals.astype(str).str.len().mean()\n",
    "            if avg_length > 20:  # Arbitrary threshold for text vs categorical\n",
    "                text_columns.append(col)\n",
    "\n",
    "if text_columns:\n",
    "    print(f\"Identified text columns: {text_columns}\")\n",
    "    \n",
    "    for col in text_columns:\n",
    "        print(f\"\\n--- {col} ---\")\n",
    "        sample_texts = df_train[col].dropna().astype(str)\n",
    "        \n",
    "        print(f\"Non-null count: {len(sample_texts)} / {len(df_train)} ({len(sample_texts)/len(df_train)*100:.1f}%)\")\n",
    "        \n",
    "        # Text length statistics\n",
    "        lengths = sample_texts.str.len()\n",
    "        print(f\"Length stats: mean={lengths.mean():.1f}, std={lengths.std():.1f}, min={lengths.min()}, max={lengths.max()}\")\n",
    "        \n",
    "        # Show some examples\n",
    "        print(f\"\\nExample texts:\")\n",
    "        for i, text in enumerate(sample_texts.head(3)):\n",
    "            print(f\"  {i+1}. {text[:100]}{'...' if len(text) > 100 else ''}\")\n",
    "        \n",
    "        # Word count approximation\n",
    "        word_counts = sample_texts.str.split().str.len()\n",
    "        print(f\"Word count stats: mean={word_counts.mean():.1f}, std={word_counts.std():.1f}\")\n",
    "        \n",
    "        # Character diversity\n",
    "        all_chars = ''.join(sample_texts.tail(1000))  # Limit for performance\n",
    "        unique_chars = len(set(all_chars))\n",
    "        print(f\"Unique characters in sample: {unique_chars}\")\n",
    "        print()\n",
    "else:\n",
    "    print(\"No obvious text columns identified by length analysis.\")\n",
    "    print(\"All object columns may be categorical or IDs.\")\n",
    print()
   ]
  },
