{
  "enabled": true,
  "profile": "balanced",
  "native_events": [
    "SessionStart",
    "SessionEnd",
    "BeforeAgent",
    "AfterAgent",
    "BeforeModel",
    "AfterModel",
    "BeforeToolSelection",
    "BeforeTool",
    "AfterTool",
    "PreCompress",
    "Notification"
  ],
  "derived_signals": {
    "context-drift": true,
    "risk-spike": true,
    "loop-stall": true,
    "token-burst": false,
    "blocker-repeat": true,
    "agent-blocked": true,
    "agent-finished-early": true,
    "stage-transition": true,
    "pre-verify": true,
    "post-verify": true,
    "checkpoint-save": true,
    "blocker-raised": true,
    "subagent-delegation": true,
    "local-inference-timeout-guard": true,
    "docker-python-verifier": true,
    "kaggle-concurrency-guard": true,
    "two-party-ivv-separation": true,
    "kagglesdk-typed-bridge": true,
    "kagglehub-zero-copy-guard": true,
    "kaggle-benchmarks-evaluator": true,
    "kaggle-agent-exam-validator": true,
    "autoharness-invariant-factory": true,
    "retrospective-skill-extractor": true,
    "universal-competition-harness": true,
    "midnight-quota-sentinel": true,
    "proprioceptive-somatic-reflex": true,
    "myotatic-ast-damping": true,
    "gto-tension-inhibition": true,
    "efference-copy-residual": true,
    "deterministic-idempotence-gate": true,
    "typed-swarm-handoff-contract": true,
    "debate-critique-conflict-resolution": true,
    "circuit-breaker-token-ceiling": true,
    "trajectory-graph-tracing": true,
    "npu-socket-serialization-guard": true,
    "tri-partite-memory-sync": true
  },
  "lanes": {
    "P0-safety": {
      "timeout_ms": 400,
      "debounce_ms": 0,
      "fail_policy": "closed",
      "description": "Critical permission, hardware, somatic mechanoreceptor, socket serialization, and circuit breaker guardrails"
    },
    "P1-quality": {
      "timeout_ms": 800,
      "debounce_ms": 200,
      "fail_policy": "warn",
      "description": "AutoHarness AST verification, typed handoff contracts, dual-store sync, and deterministic test suites"
    },
    "P2-optimization": {
      "timeout_ms": 600,
      "debounce_ms": 500,
      "fail_policy": "open",
      "description": "Context compaction, tri-partite memory sync, caching, and trajectory graph tracing"
    }
  },
  "lifecycle_policy": {
    "before_after_symmetry": true,
    "continuation_reenters_safety_lane": true,
    "terminal_states": ["completed", "blocked", "stopped"]
  },
  "runtime_controls": {
    "hook_profile_env": "OMG_HOOK_PROFILE=minimal|balanced|strict",
    "disabled_hooks_env": "OMG_DISABLED_HOOKS=learn,model-routing",
    "plans_dir_env": "GEMINI_PLANS_DIR when provided by Gemini CLI"
  },
  "team_safety": {
    "disable_side_effects_for_worker_sessions": true
  },
  "source": "oma:hooks"
}
