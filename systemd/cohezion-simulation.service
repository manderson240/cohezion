# Cohezion Simulation Service
# Install with: sudo cp cohezion-simulation.service /etc/systemd/system/
# Enable with: sudo systemctl enable cohezion-simulation.service

[Unit]
Description=Cohezion Simulation Driver
After=network.target surrealdb.service

[Service]
Type=oneshot
User=mike-anderson
WorkingDirectory=/home/mike-anderson/dev/cohezion
ExecStart=/home/mike-anderson/dev/cohezion/scripts/run_simulation_cron.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=18000

[Install]
WantedBy=multi-user.target
