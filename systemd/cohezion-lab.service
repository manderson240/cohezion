[Unit]
Description=Cohezion Autonomous AI Lab
After=network.target
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/mike-anderson/dev/cohezion
ExecStart=/home/mike-anderson/dev/cohezion/.venv/bin/python lab_driver.py
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
