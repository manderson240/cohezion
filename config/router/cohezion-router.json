{
  "version": "1",
  "model_name": "user.cohezion-router",
  "recipe": "collection.router",
  "components": [
    "llama3.2-1b-FLM",
    "qwen3.5-4b-FLM",
    "qwen3vl-it-4b-FLM"
  ],
  "routing": {
    "candidates": [
      "llama3.2-1b-FLM",
      "qwen3.5-4b-FLM",
      "qwen3vl-it-4b-FLM"
    ],
    "default_model": "qwen3.5-4b-FLM",
    "rules": [
      {
        "id": "vision",
        "match": {
          "has_images": true
        },
        "route_to": "qwen3vl-it-4b-FLM",
        "outputs": {
          "reason": "vision"
        }
      },
      {
        "id": "trivial-ack",
        "match": {
          "all": [
            {
              "max_chars": 80
            },
            {
              "any": [
                {
                  "keywords_any": [
                    "ok",
                    "yes",
                    "done",
                    "lgtm",
                    "looks good",
                    "continue",
                    "thanks",
                    "great"
                  ]
                },
                {
                  "regex": "^(ok|yes|no|done|thanks|great)[\\s!.]*$"
                }
              ]
            }
          ]
        },
        "route_to": "llama3.2-1b-FLM",
        "outputs": {
          "reason": "trivial ack"
        }
      },
      {
        "id": "default-npu",
        "match": {
          "min_chars": 0
        },
        "route_to": "qwen3.5-4b-FLM",
        "outputs": {
          "reason": "default"
        }
      }
    ]
  }
}
