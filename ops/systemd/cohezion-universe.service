[Unit]
Description=ASCENDED COHEZION - Autonomous Universe Simulation
Documentation=https://github.com/cohezion
After=network.target surrealdb.service ollama.service

[Service]
Type=simple
User=%I
WorkingDirectory=/home/%I/dev/cohezion
Environment=PYTHONPATH=/home/%I/dev/cohezion/src
Environment=COHEZION_ROOT=/home/%I/dev/cohezion
Environment=COHEZION_EMAIL=manderson240@gmail.com
Environment=COHEZION_MODE=hybrid
Environment=COHEZION_LOG_LEVEL=INFO

ExecStart=/home/%I/.local/bin/uv run python3 launch_universe_mission.py --all
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=60

# Resource limits
MemoryLimit=100G
CPUQuota=400%

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/%I/dev/cohezion/data

# Logging
StandardOutput=append:/home/%I/dev/cohezion/logs/universe_service.log
StandardError=append:/home/%I/dev/cohezion/logs/universe_service_error.log
SyslogIdentifier=cohezion-universe

[Install]
WantedBy=multi-user.target
