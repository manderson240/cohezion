[Unit]
Description=Cohezion Cloud Vault MCP Server
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=600

[Service]
Type=simple
WorkingDirectory=/home/mike-anderson/dev/cohezion/cloud-vault-mcp
Environment=PYTHONPATH=/home/mike-anderson/dev/cohezion/cloud-vault-mcp
Environment=VAULT_PATH=/home/mike-anderson/vaults/cohezion-vault
Environment=MCP_PORT=8360
Environment=MCP_API_KEY=a712027605bbd33068da5462bbcc18d90f844df23f948f124908fa726d678263
Environment=WATCHER_ENABLED=false
ExecStart=/home/mike-anderson/.local/bin/uv run python3 run_mcp.py
Restart=on-failure
RestartSec=30
MemoryMax=8G
CPUQuota=200%

[Install]
WantedBy=default.target
