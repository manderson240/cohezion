{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(uv run pytest*)",
      "Bash(uv run python*)",
      "Bash(uv lock*)",
      "Bash(make *)",
      "Bash(./scripts/*)",
      "Bash(scripts/*)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(surreal sql*)",
      "Bash(rocm*)",
      "Bash(amd-smi*)"
    ]
  },
  "env": {
    "PYTHONPATH": "src",
    "COHEZION_SESSION_ID": "",
    "ANTHROPIC_INTEL_LOCAL_LLM": "http://localhost:13305"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/codegraph/codegraph-watch.sh"
          }
        ]
      }
    ]
  }
}
