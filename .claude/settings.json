{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks claude-code session-start"
          }
        ]
      },
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mcp-health-check.sh"
          }
        ]
      },
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-concierge.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks claude-code session-end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks claude-code user-prompt-submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "all",
        "hooks": [
          {
            "type": "command",
            "command": "entire hooks claude-code stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/branch-safety-warning.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/drift-detection.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/archive-plan.sh",
            "statusMessage": "Archiving previous plan..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__cohezion-vault__vault_write|mcp__cohezion-vault__vault_edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/graph-sync-on-vault-write.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/lint-on-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/format-on-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/track-plan-files.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/test-on-edit.sh",
            "statusMessage": "Running tests..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-bash-output.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/track-plan-commits.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3:*)",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ]
  },
  "outputStyle": "Explanatory"
}
