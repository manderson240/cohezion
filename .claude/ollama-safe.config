# Safe Ollama Configuration for 128GB Unified Memory
# Prevents OOM by limiting memory usage

# === MEMORY SAFETY ===
# Maximum models to load simultaneously
# With 128GB RAM, keep max 2 models loaded at ~25-40GB each
OLLAMA_MAX_LOADED_MODELS=1

# Single inference at a time for stability
OLLAMA_NUM_PARALLEL=1

# Limit queue depth  
OLLAMA_MAX_QUEUE=10

# Keep models loaded for 30 minutes (reduce reload thrashing)
OLLAMA_KEEP_ALIVE=30m

# === GPU DETECTION ===
# Ollama 0.18+ has native gfx1151 support
# For older versions, uncomment:
# HSA_OVERRIDE_GFX_VERSION=11.5.1

# === PERFORMANCE ===
OLLAMA_FLASH_ATTENTION=1

# === CONTEXT LIMITS (CRITICAL FOR OOM PREVENTION) ===
# Default context - keep conservative to prevent OOM
# 32K is safe for all models
OLLAMA_CONTEXT_WINDOW=32768

# === RECOMMENDED MODELS BY MEMORY ===
# gemma4:e2b  - 7.2GB  - Safe context up to 128K (uses ~15GB total)
# gemma4:e4b  - 9.6GB  - Safe context up to 64K (uses ~25GB total)
# gemma4:26b  - 18GB   - Safe context up to 32K (uses ~35GB total)
# gemma4:31b  - 20GB   - Safe context up to 32K (uses ~40GB total)
# phi3:mini   - 2.2GB  - Safe context up to 128K (uses ~10GB total)

# === SAFETY TIPS ===
# 1. Never run gemma4:31b with 256K context - will use 70GB+ and crash
# 2. For large context, use smaller models (e4b or phi3:mini)
# 3. Stop all models before switching: ollama stop <model>
# 4. Check memory before large tasks: free -h && rocm-smi
# 5. If OOM occurs: sudo systemctl restart ollama