# .env.example — Reference for all Cohezion environment variables.
#
# DO NOT put real values here. This file is committed to the repo.
# To regenerate a real .env:
#   1. First-time setup:  ./scripts/secrets/seed_bitwarden.sh
#   2. Any time after:    ./scripts/secrets/restore_env.sh
#
# In production (Cloud Run), secrets come from GCP Secret Manager —
# no .env file is needed. See cloudbuild.yaml for --set-secrets wiring.

# ─── Core API Keys ─────────────────────────────────────────────────────────────

# Claude / Anthropic API. Optional if using Claude Code OAuth.
ANTHROPIC_API_KEY=

# Internal Cohezion API key for request authentication.
COHEZION_API_KEY=

# JWT signing secret. Must be a long, random string in production.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
COHEZION_SECRET_KEY=

# ─── MCP / Cloud Vault ─────────────────────────────────────────────────────────

# Bearer token for authenticating against the Cloud Vault MCP server.
MCP_API_KEY=

# API key for direct calls to the cloud-vault-mcp endpoint.
CLOUD_VAULT_API_KEY=

# ─── SurrealDB ─────────────────────────────────────────────────────────────────

# Connection URL for SurrealDB (WebSocket).
SURREALDB_URL=ws://localhost:8000

SURREALDB_NAMESPACE=cohezion
SURREALDB_DATABASE=vault

# Credentials. Use strong values — never leave as root/root in any environment.
SURREALDB_USERNAME=
SURREALDB_PASSWORD=

# Legacy single-var password (some modules still use this).
SURREAL_PASSWORD=

# ─── Notifications ─────────────────────────────────────────────────────────────

# Gmail sender address for alerts/digests.
GOOGLE_EMAIL=

# Gmail app password (NOT your Google account password).
# Create one at: https://myaccount.google.com/apppasswords
NOTIFICATION_PASSWORD=

# ─── Tunnel / Gateway ──────────────────────────────────────────────────────────

# ngrok API key for dynamic tunnel creation.
NGROK_API_KEY=

# ─── Bitwarden ─────────────────────────────────────────────────────────────────

# Session token from `bw unlock --raw`. Set in shell, not .env.
# Included here only for documentation — do not commit a real value.
BW_SESSION=

# ─── MCP Server ────────────────────────────────────────────────────────────────

MCP_HOST=127.0.0.1
MCP_PORT=8360
LOG_LEVEL=info
INBOX_MODEL=claude-haiku-4-5-20251001

# ─── Google Cloud ──────────────────────────────────────────────────────────────

# GCP project ID. When set, CredentialManager will also check GCP Secret Manager.
GOOGLE_CLOUD_PROJECT=

# ─── Ollama ────────────────────────────────────────────────────────────────────

OLLAMA_URL=http://localhost:11434
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=30

# ─── Google Sheets ─────────────────────────────────────────────────────────────

SHEETS_SPREADSHEET_ID=1YcZObTni5L-VnA7O7TIl5ghoy-i3NfXuheFt_oFbmnk
SHEETS_QUOTA_PROJECT=cohezion-477604
SHEETS_ENABLED=true
SHEETS_RESEARCH_ENABLED=false
SHEETS_RESEARCH_POLL_INTERVAL=300
SHEETS_RESEARCH_BATCH_SIZE=10
SHEETS_RESEARCH_MAX_CONCURRENT_AGENTS=4
SHEETS_RESEARCH_AGENT_TIMEOUT=300
SHEETS_RESEARCH_DB=/var/lib/sheets-research/work_queue.db
