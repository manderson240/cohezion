<task id="bmad/core/tasks/extract-entities-and-keywords.xml" name="Extract Entities and Keywords">
  <objective>Extract entities and keywords from a natural language request.</objective>
  <inputs>
    <input name="request" type="string" required="true" />
  </inputs>
  <outputs>
    <output name="entities" type="list" />
    <output name="keywords" type="list" />
  </outputs>
  <action>
    <!-- Placeholder for LLM call -->
    <set-output name="entities" value='[{"name": "example_entity", "type": "example_type", "value": "example_value"}]' />
    <set-output name="keywords" value='["example_keyword1", "example_keyword2"]' />
  </action>
</task>
