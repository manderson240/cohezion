# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Diagnostic logs (large binary files)
src/diagnostics/*.log
src/diagnostics/process_list.log
src/diagnostics/process_usage.log
src/diagnostics/memory_usage.log

# Cache and temporary files
cache/
*.cache
.cache/

# IDE and editor files
.idea/
*.swp
*.swo

# Logs
logs/*.log
*.log
!docs/**/*.log

# OS files
.DS_Store
Thumbs.db

# Generated simulation artifacts (stored in SurrealDB)
src/cohezion/knowledge_graph/universe_nodes/*/audio_scripts/
src/cohezion/knowledge_graph/universe_nodes/*/logs/
src/cohezion/knowledge_graph/universe_nodes/*/viz/

# Large data files (use database instead)
*.jsonl
!tests/**/*.jsonl

# UI Renders and Exports
renders/

# Sandbox and temporary files
*.sandbox
temp/
.sandbox/
