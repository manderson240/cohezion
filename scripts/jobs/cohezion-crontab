13 12 * * * $COHEZION_DIR/scripts/jobs/health_check_cron.sh
13 18 * * * $COHEZION_DIR/scripts/jobs/health_check_cron.sh

# === Research Scout (1x daily, 7am) ===
17 7 * * * $COHEZION_DIR/scripts/jobs/research_scout_cron.sh

# === Retrospection (2x daily: 8am, 8pm) ===
