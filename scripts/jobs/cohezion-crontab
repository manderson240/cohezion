7 12 * * * $COHEZION_DIR/scripts/jobs/compound_train_cron.sh
7 18 * * * $COHEZION_DIR/scripts/jobs/compound_train_cron.sh

# === Health Validation (4x daily: midnight, 6am, noon, 6pm) ===
