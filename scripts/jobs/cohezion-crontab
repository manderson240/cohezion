# Cohezion Proactive Improvement Cron Jobs
# Install: crontab scripts/jobs/cohezion-crontab
# Or append: crontab -l | cat - scripts/jobs/cohezion-crontab | crontab -

COHEZION_DIR=/home/mike-anderson/dev/cohezion
SHELL=/bin/bash
PATH=/home/mike-anderson/.local/bin:/usr/local/bin:/usr/bin:/bin

# === Ouroboros Healing (1x daily, 2am) ===
3 2 * * * $COHEZION_DIR/scripts/jobs/ouroboros_cron.sh

# === Compound Training (3x daily: 6am, noon, 6pm) ===
