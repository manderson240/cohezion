#!/usr/bin/env bash
# .githooks/pre-push — Pre-Push CI/CD Quality Pipeline Hook
# Runs local automerge CI gates before allowing git push to remote

set -eo pipefail

echo "== [Git Pre-Push Hook] Running Local CI/CD Quality Pipeline =="

# Run ruff ratchet check
uv run python scripts/ci/ruff_ratchet.py

# Run local LLM chokepoint check
bash scripts/ci/check_local_llm_chokepoint.sh

# Run unit tests
uv run pytest tests/unit/ -q --tb=short -p no:warnings

echo "✓ Pre-push local CI/CD gates PASSED."
