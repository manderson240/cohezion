#!/bin/sh
# pre-push: refuse direct pushes to main, then hand off to Git LFS.
#
# main only changes through a pull request whose required checks pass (GitHub ruleset).
# This hook gives the same answer locally, before the network, for every git client.
# Human escape hatch for a hotfix or release tag push: ALLOW_MAIN_PUSH=1 git push ...
#
# git passes the remote name and URL as arguments and the refs being pushed on stdin,
# one per line: <local ref> <local sha> <remote ref> <remote sha>. The target branch is
# only reliable from stdin (`git push origin feature:main` never mentions main in argv).

refs=$(cat)

if [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
        if [ "$remote_ref" = "refs/heads/main" ]; then
            printf >&2 '\n%s\n%s\n%s\n\n' \
                "pre-push: refusing to push directly to main." \
                "Land through a pull request: push your branch, open a PR, let the required checks run." \
                "(Human override for a hotfix: ALLOW_MAIN_PUSH=1 git push ...)"
            exit 1
        fi
    # The while loop runs in a pipeline subshell, so its `exit 1` only ends the subshell.
    # `|| exit 1` carries that failure to the hook; removing it silently disables the guard.
    done || exit 1
fi

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$refs" | git lfs pre-push "$@"
