#!/usr/bin/env bash
# .githooks/pre-commit — Pre-Commit SemVer & Fast Verification Hook
# Validates pyproject.toml version sync & import smoke before commit creation

set -eo pipefail
export PATH="$HOME/.local/bin:$PATH"

echo "== [Git Pre-Commit Hook] Validating SemVer & Module Imports =="


# 1. Run Version Governance Check
uv run python scripts/ci/version_governance.py

# 2. Run Fast Import Smoke Test
uv run pytest tests/unit/test_import_smoke.py -q --tb=short -p no:warnings

# 3. Run Pre-Commit Security & Artifact Guard
uv run python scripts/hooks/pre-commit.py

# 4. Run Kaggle Validation & Preflight Invariant Gates
# Precondition made explicit: on checkouts without tests/kaggle/ pytest exits 4 and
# `set -e` aborted EVERY commit, which trained `--no-verify` and skipped steps 1-3 too.
if [ -d tests/kaggle ]; then
  uv run pytest tests/kaggle/ -q --tb=short -p no:warnings
else
  echo "   (tests/kaggle/ absent on this checkout — Kaggle gate skipped)"
fi

echo "✓ Pre-commit SemVer, Import Smoke, Security & Kaggle Invariant checks PASSED."
