# BMAD MCP Infrastructure Environment Variables

# Redis
REDIS_URL=redis://localhost:6379

# BMAD MCP Server
BMAD_MCP_PORT=8361
BMAD_DATA_PATH=_bmad

# Skills.sh MCP Server
SKILLS_MCP_PORT=8362
SKILLS_CACHE_SIZE=1000

# Hugging Face MCP Server
HF_MCP_PORT=8365
HF_MCP_URL=https://huggingface.co/mcp

# MCP Manager
MANAGER_PORT=8370

# Authentication (change in production!)
MCP_API_KEY=dev-key-change-in-production

# Logging
LOG_LEVEL=INFO
VAULT_LOG_PATH=cloud-vault-mcp/vault/logs

# Ngrok (for cloud access)
# Get your token from https://dashboard.ngrok.com
# NGROK_AUTHTOKEN=your_token_here
# NGROK_DOMAIN=bmad-mcp-yourname.ngrok.io

# Hugging Face Token (required for inference and private models)
# Get your token from https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
