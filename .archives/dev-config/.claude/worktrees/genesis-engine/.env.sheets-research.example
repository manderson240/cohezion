# Google Sheets Research Pipeline Daemon Configuration
# Copy to .env.sheets-research and customize before starting the daemon

# Core vault configuration
VAULT_PATH=/home/mike-anderson/vaults/cohezion-vault

# Enable/disable the research pipeline daemon
SHEETS_RESEARCH_ENABLED=true

# Polling interval in seconds (how often to check for unresearched rows)
SHEETS_RESEARCH_POLL_INTERVAL=300

# Batch size per Haiku agent (rows per agent)
SHEETS_RESEARCH_BATCH_SIZE=10

# Maximum number of parallel Haiku agents spawned per cycle
SHEETS_RESEARCH_MAX_CONCURRENT_AGENTS=4

# Timeout in seconds for individual Haiku agent tasks
SHEETS_RESEARCH_AGENT_TIMEOUT=300

# SQLite database path for work queue and DLQ
SHEETS_RESEARCH_DB=/var/lib/sheets-research/work_queue.db

# Google Sheets configuration
SHEETS_SPREADSHEET_ID=1YcZObTni5L-VnA7O7TIl5ghoy-i3NfXuheFt_oFbmnk
SHEETS_QUOTA_PROJECT=cohezion-477604
SHEETS_ENABLED=true

# Claude API configuration (use OAuth token from ~/.claude/.credentials.json)
# ANTHROPIC_API_KEY is optional - daemon will use Claude Code OAuth if available
# ANTHROPIC_API_KEY=your-api-key-here

# Inbox processor model selection
INBOX_MODEL=claude-haiku-4-5-20251001

# Logging
LOG_LEVEL=info

# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=5

# Optional: MCP server configuration
MCP_HOST=127.0.0.1
MCP_PORT=8360
MCP_API_KEY=
