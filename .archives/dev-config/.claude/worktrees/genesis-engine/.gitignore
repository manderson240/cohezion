# === SESSION ARTIFACT PREVENTION (Repository Cleanup Session) ===
# Prevent accumulation of numbered session artifacts at repo root.
# Use number-prefix patterns to avoid blocking legitimate docs (e.g., SESSION_GUIDELINES.md).
#
# To override for a specific file, add exception BEFORE this section:
#   !SESSION_SPECIAL_DOC.md
#
# Note: docs/archive/ is NOT gitignored - archived files are committed for audit trail.

# Numbered session artifacts at root only (not in subdirectories)
/SESSION_[0-9]*
/PHASE_[0-9]*
/TASK_[0-9]*

# Backup directories from old sessions
/TASKS_BACKUP_*/
/TEAM_BACKUP_*/

# Other session-related patterns
/*_BACKUP_*/
/cohezion-session-[0-9]*/
.worktrees/
infrastructure/
.env.surrealdb
cloud-vault-mcp/history.txt

# Generated/large files discovered during triage
ruff_*.txt
ruff_*.json
mypy_*.txt
f821_out.txt

# Claude worktrees (ephemeral)
.claude/worktrees/

# BMAD runtime memory (session-specific, not version-controlled)
_bmad/_memory/

# Generated data
data/cache/
*.db

# Session archives
.archived/

# Large generated files
COHEZION_ANTHROPIC_PORTFOLIO_2026.zip

# Temporary files
*.tmp

# === DATA DIRECTORY LIFECYCLE POLICY (P3 Consensus) ===
# data/ is ephemeral cache - all contents regenerable from source
# Only track .gitkeep and README.md
data/
!data/.gitkeep
!data/README.md

# Specific cache patterns (anywhere in repo)
*.parquet
*.jsonl
*.pt
*.pkl
*.checkpoint
*.model
*.weights
*.npy
*.npz

.gemini/
gha-creds-*.json
