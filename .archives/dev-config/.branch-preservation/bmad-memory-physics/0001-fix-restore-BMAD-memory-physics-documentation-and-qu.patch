+pub fn calculate_hiho_balance(
+    half_in: &[f64],
+    half_out: &[f64]
+) -> HIHOScore {
+    let s_in = half_in.iter().map(|x| x * x).sum::<f64>().sqrt();
+    let s_out = half_out.iter().map(|x| x * x).sum::<f64>().sqrt();
+    
+    let balance = if (s_in + s_out) > 0.0 {
+        s_out / (s_in + s_out)
+    } else {
+        0.5
+    };
+    
+    let distance = (0.5 - balance).abs();
+    let stability = 1.0 - distance;
+    
+    HIHOScore { balance, distance, stability, s_in, s_out }
+}
