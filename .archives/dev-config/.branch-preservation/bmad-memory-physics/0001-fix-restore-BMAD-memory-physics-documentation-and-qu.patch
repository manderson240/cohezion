+```rust
+/// Smith Chapter II: Quadrature = √-1 = 90° rotation
+pub fn smith_quadrature_chapter_ii(state: &mut [f64; 256], plane: (usize, usize)) {
+    let (d1, d2) = plane;
+    let val1 = state[d1];
+    let val2 = state[d2];
+    
+    // (x, y) → (-y, x) = 90° rotation
+    state[d1] = -val2;
+    state[d2] = val1;
+}
+
+/// Verify Quadrature produced ~90° rotation
+pub fn verify_quadrature_angle(before: &[f64], after: &[f64], plane: (usize, usize)) -> f64 {
+    let (d1, d2) = plane;
+    let v1 = [before[d1], before[d2]];
+    let v2 = [after[d1], after[d2]];
+    
+    let dot = v1[0] * v2[0] + v1[1] * v2[1];
+    let norm1 = (v1[0] * v1[0] + v1[1] * v1[1]).sqrt();
+    let norm2 = (v2[0] * v2[0] + v2[1] * v2[1]).sqrt();
+    
+    let cos_angle = dot / (norm1 * norm2);
+    let angle_rad = cos_angle.acos();
+    let angle_deg = angle_rad.to_degrees();
+    
+    angle_deg  // Should be ~90°
+}
+```
