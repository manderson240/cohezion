#!/usr/bin/env bash
# Launch Obsidian and inbox processor daemon together.
# Daemon auto-stops when Obsidian exits.
#
# Usage: ./bin/cohezion-vault
#
# Environment variables:
#   VAULT_PATH     - Path to vault (default: ~/vaults/cohezion-vault)
#   OBSIDIAN_BIN   - Path to Obsidian binary
#   ANTHROPIC_API_KEY - Required for inbox processor
#   MCP_API_KEY    - Optional auth key for MCP server

set -euo pipefail

VAULT_PATH="${VAULT_PATH:-$HOME/vaults/cohezion-vault}"
OBSIDIAN_BIN="${OBSIDIAN_BIN:-$HOME/.local/bin/squashfs-root/obsidian}"

export VAULT_PATH

echo "[cohezion-vault] Vault: $VAULT_PATH"

# Ensure inbox directory exists
mkdir -p "$VAULT_PATH/inbox"

# Start inbox processor daemon in background
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    echo "[cohezion-vault] Starting inbox processor daemon..."
    inbox-processor &
    DAEMON_PID=$!
    trap "kill $DAEMON_PID 2>/dev/null; wait $DAEMON_PID 2>/dev/null" EXIT
    echo "[cohezion-vault] Inbox processor started (PID: $DAEMON_PID)"
else
    echo "[cohezion-vault] ANTHROPIC_API_KEY not set, skipping inbox processor"
    trap "" EXIT
fi

# Start Obsidian (blocks until closed)
if [ -x "$OBSIDIAN_BIN" ]; then
    echo "[cohezion-vault] Starting Obsidian..."
    "$OBSIDIAN_BIN" "$VAULT_PATH"
else
    echo "[cohezion-vault] Obsidian not found at $OBSIDIAN_BIN"
    echo "[cohezion-vault] Running inbox processor only (Ctrl+C to stop)"
    wait
fi

echo "[cohezion-vault] Shutdown complete"
