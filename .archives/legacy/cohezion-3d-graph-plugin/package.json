{
  "name": "cohezion-3d-graph",
  "version": "0.1.0",
  "description": "Interactive 3D visualization of Cohezion knowledge graph with 84 papers and 8-dimensional semantic metadata",
  "main": "esbuild.config.mjs",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js --sourcemap --watch",
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js",
    "test": "jest",
    "lint": "eslint src --ext ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "visualization",
    "3d-graph",
    "knowledge-graph",
    "semantic",
    "eight-dimensional"
  ],
  "author": "Mike Anderson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "16.11.6",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "esbuild": "^0.25.12",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "ajv": "^6.14.0",
    "d3-force": "^3.0.0",
    "minimatch": "^3.1.5",
    "three": "^0.169.0"
  }
}
