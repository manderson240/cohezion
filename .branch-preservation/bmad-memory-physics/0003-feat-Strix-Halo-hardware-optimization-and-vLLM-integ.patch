+++ b/scripts/setup-strix-halo.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+# Strix Halo / Ryzen AI Max OS Configuration Script
+# Automates the application of GTT pool expansion and other ROCm prerequisites
+
+set -e
+
+echo "🚀 Cohezion: Strix Halo Hardware Hardening Script"
+echo "--------------------------------------------------"
+
+# Check for root
+if [ "$EUID" -ne 0 ]; then
+  echo "❌ Please run as root (sudo ./setup-strix-halo.sh)"
+  exit 1
+fi
+
+echo "1. Configuring GRUB for 120GB GTT Pool..."
+# Backup GRUB
+cp /etc/default/grub /etc/default/grub.bak.$(date +%F_%T)
+
+# Check if parameters already exist
+if grep -q "ttm.pages_limit" /etc/default/grub; then
+    echo "⚠️  ttm.pages_limit already found in GRUB. Skipping modification to avoid duplicates."
+else
+    # 120GB = 31457280 pages (4KB pages)
+    # Add parameters to GRUB_CMDLINE_LINUX_DEFAULT
+    sed -i 's/GRUB_CMDLINE_LINUX_DEFAULT="/GRUB_CMDLINE_LINUX_DEFAULT="ttm.pages_limit=31457280 ttm.page_pool_size=31457280 /' /etc/default/grub
+    echo "✅ Applied ttm.pages_limit to GRUB configuration."
+    
+    echo "2. Updating GRUB..."
+    update-grub
+    
+    echo "✅ GRUB updated. A REBOOT IS REQUIRED for these changes to take effect."
+fi
+
+echo "3. Pulling vLLM ROCm Docker image..."
+# We use docker instead of requiring native installation to isolate the environment
+docker pull rocm/vllm-dev:main
+
+echo "--------------------------------------------------"
+echo "✅ Configuration complete."
+echo "⚠️ IMPORTANT: Please reboot your system to apply the kernel parameters."
+echo "⚠️ After rebooting, verify with: dmesg | grep -i 'gtt memory'"
