+"""vLLM ROCm adapter for high-throughput local inference."""
+
+import logging
+import os
+from typing import Any
+
+from cohezion.gateway.base_openai_adapter import BaseOpenAIGateway
+
+
+logger = logging.getLogger(__name__)
+
+
+class VllmRocmGateway(BaseOpenAIGateway):
+    """vLLM ROCm adapter with high-throughput continuous batching support.
+
+    Inherits from BaseOpenAIGateway for httpx support and common OpenAI logic.
+    Assumes vLLM is running locally on port 8000.
+    """
+
+    def __init__(
+        self,
+        api_key: str | None = None,
+        base_url: str = "http://localhost:8000/v1",
+        fallback_ollama_url: str = "http://localhost:11434",
+        enable_failover: bool = True,
+        timeout: float = 300.0,
+        max_retries: int = 3,
+    ):
+        """Initialize vLLM ROCm adapter."""
+        # vLLM API key is usually dummy but we allow overriding
+        api_key = api_key or os.getenv("VLLM_API_KEY", "ollama")
+
+        super().__init__(
+            api_key=api_key,
+            base_url=base_url,
+            fallback_ollama_url=fallback_ollama_url,
+            enable_failover=enable_failover,
+            timeout=timeout,
+            max_retries=max_retries,
+        )
+        logger.info(f"VllmRocmGateway configured: {self.base_url} (httpx enabled)")
+
+    async def generate(
+        self,
+        prompt: str,
+        model: str = "deepseek-ai/DeepSeek-R1-Distill-Llama-70B",
+        system: str = "",
+        num_predict: int = 256,
+        **kwargs: Any,
+    ) -> tuple[str, int]:
+        """Generate response with vLLM gateway or Ollama fallback."""
+        return await super().generate(prompt=prompt, model=model, system=system, num_predict=num_predict, **kwargs)
