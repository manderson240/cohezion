{
  "$schema": "https://zed.dev/schema/tasks.json",
  "version": "2",
  
  // =============================================
  // COHEZION QUANTUM-AWARE TASK RUNNER
  // Optimized for dynamic model routing and compound engineering
  // =============================================
  
  "tasks": [
    // =============================================
    // OLLAMA & MODEL MANAGEMENT
    // =============================================
    {
      "label": "🚀 Start Ollama (ZED Optimized)",
      "command": "bash",
      "args": [
        "-c", 
        "export OLLAMA_NUM_THREADS=16 && export OLLAMA_NUM_PARALLEL=4 && export OLLAMA_MAX_LOADED_MODELS=2 && ollama serve"
      ],
      "env": {
        "OLLAMA_KEEP_ALIVE": "10m",
        "OLLAMA_FLASH_ATTENTION": "1",
        "COHEZION_ROUTER_MODE": "zed_priority"
      },
      "cwd": "/home/mike-anderson/dev/cohezion",
      "group": {
        "id": "ollama_management",
        "is_default": false
      }
    },
    
    {
      "label": "📥 Load ZED Preferred Models",
      "command": "bash",
      "args": [
        "-c",
        "ollama pull phi4:latest && ollama pull qwen2.5-coder-14b-256k:latest && ollama pull qwen3:8b && echo '✅ ZED models loaded successfully'"
      ],
      "depends_on": [],
      "group": {
        "id": "ollama_management",
        "is_default": false
      }
    },
    
    {
      "label": "🔄 Restart Ollama with Dynamic Router",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f ollama || true && sleep 2 && export OLLAMA_NUM_THREADS=16 && export OLLAMA_NUM_PARALLEL=4 && export COHEZION_ROUTER_MODE=zed_priority && ollama serve &"
      ],
      "depends_on": [],
      "group": {
        "id": "ollama_management", 
        "is_default": true
      }
    },
    
    // =============================================
    // DYNAMIC ROUTER TESTING
    // =============================================
    {
      "label": "🧪 Test Dynamic Router",
      "command": "python",
      "args": [
        "/home/mike-anderson/dev/cohezion/src/cohezion/swarm/dynamic_model_router.py",
        "--test-mode"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src",
        "IDE_PRIORITY": "2"
      },
      "depends_on": ["🔄 Restart Ollama with Dynamic Router"],
      "group": {
        "id": "router_testing",
        "is_default": false
      }
    },
    
    {
      "label": "📊 Performance Benchmark",
      "command": "python",
      "args": [
        "-c",
        "import asyncio; exec(open('src/cohezion/swarm/dynamic_model_router.py').read()); asyncio.run(router.benchmark_all_models())"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": ["🧪 Test Dynamic Router"],
      "group": {
        "id": "router_testing",
        "is_default": false
      }
    },
    
    // =============================================
    // PYTHON DEVELOPMENT WORKFLOW
    // =============================================
    {
      "label": "🔍 Run All Tests",
      "command": "python",
      "args": ["-m", "pytest", "tests/", "-v", "--tb=short"],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": ["🎨 Format Code"],
      "group": {
        "id": "python_dev",
        "is_default": true
      }
    },
    
    {
      "label": "🎨 Format Code",
      "command": "ruff",
      "args": ["format", "src/"],
      "depends_on": ["🧹 Lint Code"],
      "group": {
        "id": "python_dev",
        "is_default": false
      }
    },
    
    {
      "label": "🧹 Lint Code", 
      "command": "ruff",
      "args": ["check", "src/", "--fix"],
      "depends_on": [],
      "group": {
        "id": "python_dev",
        "is_default": false
      }
    },
    
    {
      "label": "📝 Type Check",
      "command": "mypy",
      "args": ["src/", "--ignore-missing-imports"],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": ["🎨 Format Code"],
      "group": {
        "id": "python_dev",
        "is_default": false
      }
    },
    
    // =============================================
    // COHEZION-SPECIFIC WORKFLOWS
    // =============================================
    {
      "label": "🧠 Start Compound Engineering Session",
      "command": "python",
      "args": [
        "src/cohezion/swarm/compound_engineering_session.py",
        "--session-type", "zed_dev"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src",
        "COHEZION_MODE": "compound_engineering",
        "IDE_CONTEXT": "zed"
      },
      "depends_on": ["🔄 Restart Ollama with Dynamic Router"],
      "group": {
        "id": "cohezion_workflows",
        "is_default": false
      }
    },
    
    {
      "label": "🌌 Run Universe Simulation",
      "command": "python",
      "args": [
        "src/cohezion/simulation/fractal_universe.py",
        "--interactive",
        "--max-steps", "1000"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": [],
      "group": {
        "id": "cohezion_workflows",
        "is_default": false
      }
    },
    
    {
      "label": "📚 Update Knowledge Graph",
      "command": "python",
      "args": [
        "src/cohezion/knowledge_graph/update_knowledge.py",
        "--recursive",
        "--update-learnings"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": [],
      "group": {
        "id": "cohezion_workflows",
        "is_default": false
      }
    },
    
    // =============================================
    // SYSTEM INTEGRATION
    // =============================================
    {
      "label": "🔧 Start SurrealDB",
      "command": "bash",
      "args": [
        "-c",
        "$HOME/.surrealdb/surreal start --user root --pass root file://$HOME/dev/cohezion/data/surrealdb"
      ],
      "depends_on": [],
      "group": {
        "id": "system_services",
        "is_default": false
      }
    },
    
    {
      "label": "📊 Start Performance Monitor",
      "command": "python",
      "args": [
        "src/cohezion/reliability/monitor.py",
        "--dashboard",
        "--port", "8080"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": ["🔧 Start SurrealDB"],
      "group": {
        "id": "system_services",
        "is_default": false
      }
    },
    
    // =============================================
    // MODEL MANAGEMENT & OPTIMIZATION
    // =============================================
    {
      "label": "🧹 Clean Model Cache",
      "command": "bash",
      "args": [
        "-c",
        "ollama stop $(ollama list | awk 'NR>1{print $1}') 2>/dev/null || true && echo '✅ All models stopped'"
      ],
      "depends_on": [],
      "group": {
        "id": "model_management",
        "is_default": false
      }
    },
    
    {
      "label": "📈 Model Performance Report",
      "command": "python",
      "args": [
        "-c",
        "import json; from src.cohezion.swarm.dynamic_model_router import router; report = router.generate_performance_report(); print(json.dumps(report, indent=2))"
      ],
      "env": {
        "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
      },
      "depends_on": ["📊 Performance Benchmark"],
      "group": {
        "id": "model_management",
        "is_default": false
      }
    }
  ]
}