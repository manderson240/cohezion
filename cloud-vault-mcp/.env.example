# Cloud Vault MCP Server Configuration
# Copy to .env and fill in values

# API key for MCP server authentication (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
# NOTE: the key previously hardcoded in run_mcp.py is in git history => COMPROMISED. Rotate it.
MCP_API_KEY=

# SurrealDB password (required by run_mcp.py; do NOT commit the real value)
SURREALDB_PASS=

# Server port (default: 8360)
MCP_PORT=8360

# Vault path inside container (default: /vault)
VAULT_PATH=/vault

# CORS allowed origins (comma-separated, default: *)
CORS_ORIGINS=*

# Log level (default: info)
LOG_LEVEL=info

# Git sync interval in seconds (default: 300 = 5 minutes)
GIT_SYNC_INTERVAL=300

# Git remote URL for vault backup (optional)
GIT_REMOTE_URL=

# Domain name for TLS (used by nginx)
DOMAIN=vault.example.com
