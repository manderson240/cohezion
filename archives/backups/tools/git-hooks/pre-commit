#!/usr/bin/env bash
# Vault brain-region protection hook.
# Blocks commits that mass-delete from cortex/ or cerebellum/.
#
# Install:  cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Override: VAULT_DELETION_OK=1 git commit   OR   git commit --no-verify

set -euo pipefail

PROTECTED_DIRS=("cortex" "cerebellum")
WARN_THRESHOLD=3  # deletions in a protected dir that trigger the guard

declare -A deletion_counts
triggered=0

for dir in "${PROTECTED_DIRS[@]}"; do
    count=$(git diff --cached --name-status 2>/dev/null | awk -v d="$dir/" '$1=="D" && index($2,d)==1' | wc -l)
    if [ "$count" -ge "$WARN_THRESHOLD" ]; then
        deletion_counts["$dir"]=$count
        triggered=1
    fi
done

[ "$triggered" -eq 0 ] && exit 0

echo ""
echo "VAULT PROTECTION: staged deletions in brain-region directories"
echo ""
for dir in "${!deletion_counts[@]}"; do
    echo "  $dir/  —  ${deletion_counts[$dir]} files staged for deletion"
done
echo ""
echo "These directories contain knowledge neurons that are expensive to recover."
echo ""

# Explicit override via env var (useful in scripts / Entire sessions)
if [ -n "${VAULT_DELETION_OK:-}" ]; then
    echo "VAULT_DELETION_OK is set — proceeding."
    exit 0
fi

# Interactive prompt
if [ -t 0 ]; then
    read -r -p "Delete anyway? [y/N] " response
    case "$response" in
        [yY][eE][sS]|[yY])
            echo "Proceeding with deletion."
            exit 0
            ;;
        *)
            echo "Commit aborted. Use VAULT_DELETION_OK=1 or --no-verify to override."
            exit 1
            ;;
    esac
fi

# Non-interactive (CI / Entire): hard-block
echo "Non-interactive session — aborting to protect vault."
echo "Set VAULT_DELETION_OK=1 to allow this deletion."
exit 1
