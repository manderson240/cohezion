{
  "$schema": "https://zed.dev/schema/settings.json",
  
  // =============================================
  // COHEZION QUANTUM-AWARE ZED CONFIGURATION v1.1.48
  // Optimized for AMD Ryzen AI MAX+ 395 with 125GB DDR5
  // =============================================
  
  "theme": "One Dark",
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "buffer_font_family": "Cascadia Code PL",
  
  // =============================================
  // PROJECT-SPECIFIC WORKSPACE CONFIGURATION
  // =============================================
  "project_panel": {
    "folder_icons": true,
    "git_status": true,
    "indent_size": 12,
    "auto_fold_dirs": [
      "__pycache__", 
      "node_modules", 
      ".git", 
      "data", 
      "logs", 
      "cache", 
      ".archive"
    ]
  },
  
  // =============================================
  // PYTHON LSP & DYNAMIC ROUTING INTEGRATION
  // =============================================
  "languages": {
    "Python": {
      "language_servers": ["pylsp", "ruff", "dynamic_router"],
      "format_on_save": {
        "language_server": "ruff"
      },
      "preferred_line_length": 88,
      "tab_size": 4,
      "soft_wrap": "preferred_line_length",
      
      // COHEZION-SPECIFIC PYTHON ENHANCEMENTS
      "prettier": {
        "enabled": false  // Use ruff instead
      },
      
      // Dynamic routing for Python completion
      "completion": {
        "provider": "dynamic_router",
        "preferred_models": ["phi4:latest", "qwen2.5-coder-14b-256k:latest"],
        "max_context": 128000,
        "cache_size": 1000
      }
    },
    
    "TypeScript": {
      "language_servers": ["typescript-language-server", "eslint", "dynamic_router"],
      "format_on_save": {
        "language_server": "prettier"
      },
      "preferred_line_length": 100,
      "tab_size": 2
    },
    
    "JSON": {
      "format_on_save": {
        "language_server": "prettier"
      }
    },
    
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 80,
      "spell_check": true
    }
  },
  
  // =============================================
  // LANGUAGE SERVER CONFIGURATION
  // =============================================
  "lsp": {
    "pylsp": {
      "command": "pylsp",
      "args": ["--config", ".pylsp.toml"],
      "settings": {
        "pylsp": {
          "plugins": {
            "pycodestyle": { "enabled": true, "maxLineLength": 88 },
            "mccabe": { "enabled": true, "threshold": 12 },
            "pyflakes": { "enabled": true },
            "pylsp_mypy": { "enabled": true },
            "jedi_completion": { 
              "enabled": true,
              "include_params": true,
              "fuzzy": true
            }
          }
        }
      }
    },
    
    "ruff": {
      "command": "ruff",
      "args": ["server"],
      "settings": {
        "lineLength": 88,
        "lint": {
          "select": ["E", "F", "W", "I", "B", "C4", "UP"],
          "ignore": ["E501"]
        },
        "format": {
          "quoteStyle": "double",
          "indentStyle": "space"
        }
      }
    },
    
    // =============================================
    // COHEZION DYNAMIC ROUTER LSP INTEGRATION
    // =============================================
    "dynamic_router": {
      "command": "python",
      "args": [
        "/home/mike-anderson/dev/cohezion/src/cohezion/swarm/dynamic_model_router.py",
        "--lsp-mode"
      ],
      "environment": {
        "OLLAMA_HOST": "localhost:11434",
        "COHEZION_ROUTER_MODE": "zed_priority",
        "IDE_PRIORITY": "2"  // ZED priority level
      },
      
      // Connection to our routing system
      "settings": {
        "routing_strategy": "balanced",
        "preferred_models": ["phi4:latest", "qwen2.5-coder-14b-256k:latest"],
        "fallback_model": "qwen3:8b",
        "max_concurrent_requests": 4,
        "cache_enabled": true,
        "template_adaptation": true
      }
    }
  },
  
  // =============================================
  // TERMINAL & OLLAMA INTEGRATION
  // =============================================
  "terminal": {
    "font_family": "Cascadia Code PL",
    "font_size": 12,
    "blink_cursor": true,
    "alternate_scroll": true,
    "shell": {
      "program": "/bin/bash",
      "args": ["--login"]
    },
    
    // Quick access to Ollama management
    "environment": {
      "OLLAMA_NUM_THREADS": "16",  // 50% of 32 threads for ZED
      "OLLAMA_NUM_PARALLEL": "4",
      "OLLAMA_MAX_LOADED_MODELS": "2",
      "OLLAMA_KEEP_ALIVE": "10m"
    }
  },
  
  // =============================================
  // TROUBLESHOOTING & PERFORMANCE MONITORING
  // =============================================
  "telemetry": {
    "metrics": {
      "enabled": true,
      "collection_level": "detailed"
    }
  },
  
  // =============================================
  // ZED-SPECIFIC TASK CONFIGURATION
  // =============================================
  "tasks": {
    "version": "2",
    "tasks": [
      {
        "label": "Start Ollama with ZED Optimizations",
        "command": "bash",
        "args": ["-c", "OLLAMA_NUM_THREADS=16 OLLAMA_NUM_PARALLEL=4 ollama serve"],
        "env": {
          "OLLAMA_MAX_LOADED_MODELS": "2",
          "OLLAMA_KEEP_ALIVE": "10m"
        }
      },
      
      {
        "label": "Load Preferred Models",
        "command": "bash",
        "args": [
          "-c",
          "ollama pull phi4:latest && ollama pull qwen2.5-coder-14b-256k:latest && ollama pull qwen3:8b"
        ]
      },
      
      {
        "label": "Run Dynamic Router Test",
        "command": "python",
        "args": [
          "/home/mike-anderson/dev/cohezion/src/cohezion/swarm/dynamic_model_router.py",
          "--test-mode"
        ]
      },
      
      {
        "label": "Project Test Suite",
        "command": "python",
        "args": ["-m", "pytest", "tests/", "-v"],
        "env": {
          "PYTHONPATH": "/home/mike-anderson/dev/cohezion/src"
        }
      },
      
      {
        "label": "Code Quality Check",
        "command": "ruff",
        "args": ["check", "src/", "--fix"],
        "depends_on": ["format_code"]
      },
      
      {
        "label": "Format Code", 
        "command": "ruff",
        "args": ["format", "src/"],
        "depends_on": []
      }
    ]
  },
  
  // =============================================
  // AUTO-COMPLETION & INTELLISENSE
  // =============================================
  "auto_completion": true,
  "hover_popover_character_count": 800,
  "confirm_on_suggest_completion": false,
  "accept_on_suggestion": true,
  
  // =============================================
  // COHEZION PROJECT-SPECIFIC CONFIGURATION
  // =============================================
  "file_types": {
    "Python File": {
      "tab_size": 4,
      "soft_wrap": "none"
    },
    
    "Configuration": {
      "extensions": [".toml", ".yaml", ".yml", ".json"],
      "tab_size": 2
    },
    
    "COHEZION Special": {
      "extensions": [".prime", ".ascended", ".infinity"],
      "language": "Python",
      "comment_tokens": ["#", "//", "/*", "*/"],
      "bracket_pairs": [
        ["(", ")"],
        ["[", "]"], 
        ["{", "}"],
        ["<", ">"]
      ]
    }
  },
  
  // =============================================
  // AUTO-SAVE & BACKUP
  // =============================================
  "autosave": {
    "enabled": true,
    "after_delay": {
      "milliseconds": 1000
    },
    "on_focus_change": true,
    "on_window_change": true
  },
  
  // =============================================
  // MINIMAP & VISUAL ENHANCEMENTS  
  // =============================================
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "search_results": true,
    "selected_text": true
  },
  
  "minimap": {
    "show": true,
    "scrollbar_indicator": true,
    "mini_map_render": "text"
  },
  
  // =============================================
  // SEARCH & NAVIGATION
  // =============================================
  "search": {
    "case_sensitive": false,
    "whole_word": false,
    "regex": false,
    "include_context_lines": true
  },
  
  "outline": {
    "show_definitions": true,
    "show_outline": true
  },
  
  // =============================================
  // INTEGRATION EXCLUSIONS (COHEZION-SPECIFIC)
  // =============================================
  "files": {
    "exclude": {
      "**/__pycache__": true,
      "**/node_modules": true,
      "**/.git": true,
      "src/cohezion/knowledge_graph/universe_nodes": true,
      "data": true,
      "logs": true,
      "cache": true,
      ".archive": true,
      "apps/webapp/dist": true,
      "apps/webapp/node_modules": true,
      
      // COHEZION-SPECIFIC EXCLUSIONS
      "**/*.log": true,
      "**/.venv": true,
      "**/venv": true,
      "**/.pytest_cache": true,
      "**/.mypy_cache": true,
      "**/.ruff_cache": true,
      "**/uv.lock": true,
      "src/cohezion/simulation/**/output_*.json": true,
      "storage/**": true
    }
  },
  
  "search": {
    "exclude": {
      "**/node_modules": true,
      "src/cohezion/knowledge_graph/universe_nodes": true,
      "data": true,
      "logs": true,
      "cache": true,
      ".archive": true,
      "apps/webapp/dist": true,
      
      // COHEZION-SPECIFIC SEARCH EXCLUSIONS
      "**/*.log": true,
      "**/output_*.json": true,
      "**/cache/**": true
    }
  },
  
  // =============================================
  // GIT INTEGRATION
  // =============================================
  "git": {
    "git_gutter": {
      "enabled": true,
      "moved": true
    },
    "inline_blame": {
      "enabled": true
    },
    "file_history": {
      "enabled": true
    }
  }
}