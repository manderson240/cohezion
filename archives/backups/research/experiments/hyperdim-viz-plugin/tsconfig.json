{
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./",
    "rootDir": "./src",
    "target": "ES6",
    "allowJs": true,
    "module": "ESNext",
    "lib": ["DOM", "ES5", "ES6", "ES7"],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts"]
}
