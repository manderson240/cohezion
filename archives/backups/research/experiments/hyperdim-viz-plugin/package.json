{
  "name": "hyperdim-compound-viz",
  "version": "0.1.0",
  "description": "12D graph visualization for compound engineering with agent tracking and capability measurement",
  "main": "esbuild.config.mjs",
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js --sourcemap --watch",
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:@codemirror/autocomplete --outfile=main.js",
    "test": "jest",
    "lint": "eslint src --ext ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "visualization",
    "graph",
    "12d",
    "compound-engineering",
    "agent-tracking"
  ],
  "author": "Mike Anderson",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "16.11.6",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "esbuild": "^0.25.12",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "ajv": "^6.14.0",
    "minimatch": "^3.1.5",
    "three": "^0.169.0"
  }
}
