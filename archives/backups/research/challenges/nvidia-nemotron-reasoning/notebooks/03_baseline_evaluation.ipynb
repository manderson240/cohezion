    "# Prepare Data Loaders\n",
    "print(\"=== PREPARING DATA LOADERS ===\")\n",
    "\n",
    "print(\"Creating datasets...\")\n",
    "train_dataset = ReasoningDataset(df_train, tokenizer, Config.MAX_LENGTH)\n",
    "val_size = int(0.1 * len(df_train))  # 10% for validation\n",
    "train_dataset_subset = torch.utils.data.Subset(train_dataset, range(len(df_train) - val_size))\n",
    "val_dataset = torch.utils.data.Subset(train_dataset, range(len(df_train) - val_size, len(df_train)))\n",
    "\n",
    f\"Training samples: {len(train_dataset_subset)}\")\n",
    f\"Validation samples: {len(val_dataset)}\")\n",
    print()\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_dataset_subset,\n",
    "    batch_size=Config.BATCH_SIZE,\n",
    "    shuffle=True,\n",
    "    num_workers=2,\n",
    "    pin_memory=True\n",
    ")\n",
    "\n",
    \"val_loader = DataLoader(\n",
    \"    val_dataset,\n",
    \"    batch_size=Config.BATCH_SIZE,\n",
    \"    shuffle=False,\n",
    \"    num_workers=2,\n",
    \"    pin_memory=True\n",
    \")\")\n",
    \n",
    print(\"✓ Data loaders created!\")\n",
    print()
   ]
