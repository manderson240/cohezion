    f\"  r = {Config.LORA_R}\")\n",
    f\"  lora_alpha = {Config.LORA_ALPHA}\")\n",
    f\"  target_modules = {Config.LORA_TARGET_MODULES}\")\n",
    f\"  lora_dropout = {Config.LORA_DROPOUT}\")\n",
    print()\n",
    "\n",
    "lora_config = LoraConfig(\n",
    "    r=Config.LORA_R,\n",
    "    lora_alpha=Config.LORA_ALPHA,\n",
    "    target_modules=Config.LORA_TARGET_MODULES,\n",
    "    lora_dropout=Config.LORA_DROPOUT,\n",
    "    bias=\"none\",\n",
    "    task_type=\"CAUSAL_LM\"\n",
    ")\n",
    "\n",
    "print(\"Preparing model for LoRA...\")\n",
    "model = prepare_model_for_int8_training(model) if hasattr(model, 'is_loaded_in_8bit') and model.is_loaded_in_8bit else model\n",
    "\n",
    "print(\"Applying LoRA to model...\")\n",
    "model = get_peft_model(model, lora_config)\n",
    "print(\"✓ LoRA applied successfully!\")\n",
