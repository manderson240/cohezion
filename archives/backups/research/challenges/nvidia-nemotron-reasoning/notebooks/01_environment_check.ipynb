    "# Environment Check for NVIDIA Nemotron Model Reasoning Challenge\n",
    "\n",
    "This notebook validates that our environment is properly set up for working on the NVIDIA Nemotron Model Reasoning Challenge, building upon the existing Gemini session work.\n",
    "\n",
    "## Overview\n",
    "\n",
    "We'll check:\n",
    "1. Python version and basic environment\n",
    "2. Availability of key packages\n",
    "3. Access to competition data (via symlinks)\n",
    "4. Ability to load and work with the existing Gemini session work\n",
    "5. Basic functionality of key libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Basic Environment Check\n",
    "import sys\n",
    "import os\n",
    "import platform\n",
    "\n",
    "print(\"=== SYSTEM INFORMATION ===\")\n",
    f\"Python Version: {sys.version}\"\n",
    f\"Platform: {platform.platform()}\"\n",
    f\"Machine: {platform.machine()}\"\n",
    f\"Processor: {platform.processor()}\"\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Key Packages Check\n",
    "packages_to_check = [\n",
    "    ('torch', 'PyTorch'),\n",
    "    ('transformers', 'Hugging Face Transformers'),\n",
    "    ('peft', 'PEFT - Parameter-Efficient Fine-Tuning'),\n",
    "    ('datasets', '🤗 Datasets'),\n",
    "    ('pandas', 'Pandas'),\n",
    "    ('numpy', 'NumPy'),\n",
    "    ('sklearn', 'Scikit-learn'),\n",
    "    ('matplotlib', 'Matplotlib'),\n",
    "    ('seaborn', 'Seaborn'),\n",
    "    ('wandb', 'Weights & Biases')\n",
    "]\n",
    "\n",
    "print(\"=== PACKAGE AVAILABILITY ===\")\n",
    "all_good = True\n",
    "for package, name in packages_to_check:\n",
    "    try:\n",
    "        pkg = __import__(package)\n",
    "        version = getattr(pkg, '__version__', 'unknown')\n",
    "        if version == 'unknown':\n",
    "            # Try common version attributes\n",
    "            for attr in ['version', '__version_tuple__']:\n",
    "                if hasattr(pkg, attr):\n",
    "                    val = getattr(pkg, attr)\n",
    "                    if hasattr(val, '__iter__') and not isinstance(val, str):\n",
    "                        version = '.'.join(map(str, val))\n",
    "                    else:\n",
    "                        version = str(val)\n",
    "                    break\n",
    "        print(f\"✓ {name}: {version}\")\n",
    "    except ImportError as e:\n",
    "        print(f\"✗ {name}: NOT INSTALLED ({e})\")\n",
    "        all_good = False\n",
    "    except Exception as e:\n",
    "        print(f\"✗ {name}: ERROR - {e}\")\n",
    "        all_good = False\n",
    "\n",
    "if all_good:\n",
    "    print(\"\\n✓ All key packages are available!\")\n",
    "else:\n",
    "    print(\"\\n✗ Some packages are missing. Please install them.\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Competition Data Access Check\n",
    "print(\"=== COMPETITION DATA ACCESS ===\")\n",
    "\n",
    "# Check symlinked data files\n",
    "data_dir = 'data'\n",
    "train_path = os.path.join(data_dir, 'train.csv')\n",
    "test_path = os.path.join(data_dir, 'test.csv')\n",
    "\n",
    "if os.path.exists(train_path) and os.path.islink(train_path):\n",
    "    print(f\"✓ Train data symlink: {train_path}\")\n",
    "    print(f\"  → Points to: {os.readlink(train_path)}\")\n",
    "    # Check file size\n",
    "    size_mb = os.path.getsize(train_path) / (1024 * 1024)\n",
    "    print(f"  Size: {size_mb:.1f} MB\")\n",
    "else:\n",
    "    print(f\"✗ Train data symlink missing or broken: {train_path}\")\n",
    "\n",
    "if os.path.exists(test_path) and os.path.islink(test_path):\n",
    "    print(f\"✓ Test data symlink: {test_path}\")\n",
    "    print(f\"  → Points to: {os.readlink(test_path)}\")\n",
    "    size_mb = os.path.getsize(test_path) / (1024 * 1024)\n",
    "    print(f\"  Size: {size_mb:.1f} MB\")\n",
    "else:\n",
    "    print(f\"✗ Test data symlink missing or broken: {test_path}\")\n",
    "\n",
    "# Quick data peek\n",
    "try:\n",
    "    import pandas as pd\n",
    "    df_train = pd.read_csv(train_path, nrows=5)\n",
    "    print(f\"\\nTrain data shape: {pd.read_csv(train_path).shape}\")\n",
    "    print(f\"Train data columns: {list(df_train.columns)}\")\n",
    "    print(f\"First few rows:\\n{df_train.head()}\")\n",
    "except Exception as e:\n",
    "    print(f\"Error reading train data: {e}\")\n",
    print()
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
