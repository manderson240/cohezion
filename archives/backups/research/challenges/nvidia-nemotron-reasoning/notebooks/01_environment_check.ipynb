    "if os.path.exists(gemini_notebook):\n",
    "    print(f\"✓ Found Gemini session work: {gemini_notebook}\")\n",
    "    try:\n",
    "        import json\n",
    "        with open(gemini_notebook, 'r') as f:\n",
