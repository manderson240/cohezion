# Cohezion Simulation Timer
# Install with: sudo cp cohezion-simulation.timer /etc/systemd/system/
# Enable with: sudo systemctl enable --now cohezion-simulation.timer

[Unit]
Description=Cohezion Simulation Timer
Requires=cohezion-simulation.service

[Timer]
# Run at midnight, 6 AM, noon, and 6 PM every day
OnCalendar=*-*-* 00:00:00
OnCalendar=*-*-* 06:00:00
OnCalendar=*-*-* 12:00:00
OnCalendar=*-*-* 18:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
