# Dockerfile for Cohezion Environmental Data MCP Server
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir fastmcp

# Copy source code
COPY src/cohezion/mcp/env_data_mcp.py .

# Expose MCP port (simulated)
EXPOSE 8000

# Run the server
CMD ["python", "env_data_mcp.py"]
