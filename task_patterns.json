# Task Patterns for Compound Engineering

{
  "patterns": {
    "simple-feature": {
      "description": "Basic feature implementation",
      "complexity": "low",
      "models": ["simple-coding"],
      "sequence": ["plan", "implement", "test"],
      "memory_estimate": 20,
      "typical_duration": "5-15min",
      "success_metrics": ["code_quality", "test_coverage", "performance"]
    },
    "complex-feature": {
      "description": "Complex feature with multiple components",
      "complexity": "medium",
      "models": ["complex-coding"],
      "sequence": ["analyze", "design", "implement", "integrate", "test"],
      "memory_estimate": 45,
      "typical_duration": "30-60min",
      "success_metrics": ["modularity", "scalability", "maintainability"]
    },
    "system-architecture": {
      "description": "Complete system architecture design",
      "complexity": "high",
      "models": ["system-design"],
      "sequence": ["requirements", "high-level-design", "detailed-design", "validation"],
      "memory_estimate": 40,
      "typical_duration": "1-2h",
      "success_metrics": ["scalability", "performance", "security"]
    },
    "full-application": {
      "description": "Complete application development",
      "complexity": "very-high",
      "models": ["full-engineering"],
      "sequence": ["planning", "design", "implementation", "integration", "testing", "deployment"],
      "memory_estimate": 65,
      "typical_duration": "2-4h",
      "success_metrics": ["completeness", "performance", "usability"]
    },
    "algorithm-optimization": {
      "description": "Performance optimization of algorithms",
      "complexity": "medium",
      "models": ["mathematical-optimization"],
      "sequence": ["analysis", "optimization", "benchmarking", "validation"],
      "memory_estimate": 42,
      "typical_duration": "30-90min",
      "success_metrics": ["performance_gain", "efficiency", "correctness"]
    },
    "api-development": {
      "description": "REST API development with documentation",
      "complexity": "medium",
      "models": ["complex-coding"],
      "sequence": ["design", "implementation", "documentation", "testing"],
      "memory_estimate": 45,
      "typical_duration": "45-90min",
      "success_metrics": ["api_quality", "documentation_completeness", "test_coverage"]
    },
    "database-schema": {
      "description": "Database schema design and optimization",
      "complexity": "medium",
      "models": ["system-design"],
      "sequence": ["requirements_analysis", "schema_design", "normalization", "optimization"],
      "memory_estimate": 38,
      "typical_duration": "30-60min",
      "success_metrics": ["schema_quality", "performance", "scalability"]
    },
    "microservices-architecture": {
      "description": "Microservices system design",
      "complexity": "very-high",
      "models": ["full-engineering"],
      "sequence": ["system_analysis", "service_design", "api_definition", "deployment_strategy", "monitoring"],
      "memory_estimate": 68,
      "typical_duration": "3-5h",
      "success_metrics": ["scalability", "maintainability", "deployment_efficiency"]
    }
  },
  "model_mappings": {
    "plan": "gpt-oss-256k",
    "design": "qwen3-coder-256k",
    "implement": "glm-4.7-flash-256k",
    "analyze": "gpt-oss-256k",
    "optimize": "phi4-256k",
    "test": "qwen3-coder-256k",
    "integrate": "qwen3-coder-256k",
    "validate": "gpt-oss-256k",
    "document": "qwen3-coder-256k"
  },
  "task_recognition": {
    "keywords": {
      "plan": ["design", "architecture", "plan", "structure", "outline"],
      "implement": ["build", "create", "develop", "code", "implement"],
      "analyze": ["analyze", "review", "examine", "investigate", "study"],
      "optimize": ["optimize", "improve", "enhance", "refactor", "tune"],
      "test": ["test", "validate", "verify", "check", "debug"]
    }
  },
  "complexity_assessment": {
    "simple": {
      "criteria": ["single_component", "clear_requirements", "straightforward_implementation"],
      "model_combination": "simple-coding",
      "estimated_memory": 20
    },
    "medium": {
      "criteria": ["multiple_components", "some_complexity", "integration_required"],
      "model_combination": "complex-coding",
      "estimated_memory": 45
    },
    "high": {
      "criteria": ["system_level", "complex_interactions", "performance_requirements"],
      "model_combination": "system-design",
      "estimated_memory": 40
    },
    "very-high": {
      "criteria": ["enterprise_level", "multiple_services", "scalability_requirements"],
      "model_combination": "full-engineering",
      "estimated_memory": 65
    }
  }
}