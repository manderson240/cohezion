        O1[spatial_x]
        O2[tempic]
        O3[logic]
        O4[awareness]
        O5[coherence]
    end
    
    subgraph Semantic["2048D Semantic Context Tier"]
        S1[LLM Embedding]
        S2[Semantic Intent]
